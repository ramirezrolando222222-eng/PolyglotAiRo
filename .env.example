# Polyglot AI — RO Environment Configuration

# Memory storage path
RO_MEMORY_PATH=data/ro_memory.json

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API configuration (when API service is implemented)
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# Provider configuration (provider-specific keys go here)
# Do NOT commit actual secrets. Use placeholder values.
# AI_PROVIDER=openai
# AI_PROVIDER_KEY=your-api-key-here
# AI_MODEL=gpt-4

# Project settings
# PROJECT_NAME=Polyglot AI
# PROJECT_VERSION=0.1.0
